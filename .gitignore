# --- Ambiente Python ---
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# --- Dati grezzi GME (pesanti: ~6 GB, restano fuori dal versionamento) ---
*.xml
*.zip
MGP_OffertePubbliche/

# --- Cache e dati derivati (rigenerabili dagli script) ---
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Output (rigenerabili) ---
# I .docx dei report NON si versionano: si rigenerano dal Markdown in docs/report/,
# che e' invece versionato.
output/figure/*
output/tabelle/*
output/report/*
!output/figure/.gitkeep
!output/tabelle/.gitkeep
~$*.docx

# --- LaTeX: file ausiliari e PDF compilato (rigenerabili) ---
*.aux
*.toc
*.lof
*.lot
*.out
*.bbl
*.bcf
*.blg
*.run.xml
*.synctex.gz
*.fls
*.fdb_latexmk
latex/main.pdf

# --- Strumenti locali di lavoro (non fanno parte del progetto) ---
CLAUDE.md
.claude/

# --- Varie ---
.Rhistory
*.log

# Letteratura scientifica: PDF di articoli soggetti a copyright, ~100 MB.
# Non vanno su GitHub: si tengono in locale come materiale di lavoro.
scientific literature/
